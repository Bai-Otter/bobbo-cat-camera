# Confirmed local startup settings; contains no API key.
# Copy to the service-root .env. Change the directory on other machines.
MUKBANG_VISION_USE_CODEX_PROVIDER=1
MUKBANG_CODEX_HOME=E:/APP/Codex/home
MUKBANG_VISION_MODEL=gpt-6.1-sol
MUKBANG_VISION_TIMEOUT_SECONDS=600
MUKBANG_VISION_CODEX_CLIENT_COMPAT=0
