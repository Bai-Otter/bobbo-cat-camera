# Copy to .env locally, then replace the example URL and add your own key.
# Existing process environment variables take precedence over .env.
MUKBANG_VISION_USE_CODEX_PROVIDER=0
# Default off. Only for the explicitly imported, unchanged Codex Responses relay.
# Adds two public client labels, not authentication or a grant of API access.
# Does not change request bodies, the deadline or the single-POST/no-retry rule.
MUKBANG_VISION_CODEX_CLIENT_COMPAT=0
MUKBANG_VISION_BASE_URL=https://relay.example.com/v1
MUKBANG_VISION_MODEL=gpt-6.1-sol
MUKBANG_VISION_API_STYLE=responses
MUKBANG_VISION_API_KEY=
# Request waiting limit in seconds (finite 30–1800; default 600).
# One absolute deadline covers connection, response headers and the full body;
# expiry cancels the active request, including a blocked or slowly dripping read.
# Slow streaming responses may exceed four minutes; no automatic retry is made.
MUKBANG_VISION_TIMEOUT_SECONDS=600

# Decoder threads for ffprobe's full frame-time scan only; not encoder threads.
# Integer 0–32, default 4. Use 0 for FFmpeg's automatic setting.
MUKBANG_FFPROBE_THREADS=4

# Optional paid Breeze narration for stories. Only enable in the intended process.
MUKBANG_BREEZE_ENABLED=0
BREEZE_API_KEY_FILE=
MUKBANG_BREEZE_VOICE_ID=
MUKBANG_BREEZE_MODEL=breeze-tts-2
# Store credentials outside the repo; never put them in job artifacts or Prompt.
# Errors retain the subtitle-only story. No additional vision calls or BGM.

# Use chat_completions instead if that is the provider's supported wire format.
# The model must support multiple image inputs; the model name is provider-specific.

# Optional: explicitly reuse your own local Codex provider instead of the above.
# MUKBANG_VISION_USE_CODEX_PROVIDER=1
# MUKBANG_CODEX_HOME=/absolute/path/to/your/codex-home
# This reads config.toml/auth.json locally; never copy them into this repository.
