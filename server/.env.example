# 杰峰开放平台应用凭证
JF_UUID=YOUR_JF_UUID
JF_APPKEY=YOUR_JF_APPKEY
JF_APPSECRET=YOUR_JF_APPSECRET
JF_MOVECARD=YOUR_JF_MOVECARD

# 设备信息
JF_DEVICE_SN=YOUR_DEVICE_SN
JF_DEVICE_USERNAME=admin
# Can be empty when the camera has no local admin password.
JF_DEVICE_PASSWORD=YOUR_DEVICE_PASSWORD
# Local file used to remember bound devices across backend restarts.
# JF_DEVICE_REGISTRY_FILE=./data/devices.json

# 接入地址
JF_ENDPOINT=api-cn.jftechws.com

# 服务监听
# WeChat Cloud Hosting injects PORT in production. Keep PORT only for local dev.
PORT=3000
HOST=0.0.0.0
# Set this when Nginx/Caddy terminates public HTTPS and proxies to this service.
# HTTP_BEHIND_PROXY=true

# “布卜布卜”微信登录。AppSecret 只能保存在服务端，严禁写入小程序源码。
WECHAT_APP_ID=touristappid
WECHAT_APP_SECRET=
WECHAT_DEVICE_MESSAGE_MODEL_ID=
WECHAT_DEVICE_MESSAGE_START_TEMPLATE_ID=
WECHAT_DEVICE_MESSAGE_END_TEMPLATE_ID=
WECHAT_DEVICE_MESSAGE_START_DATA_JSON={}
WECHAT_DEVICE_MESSAGE_END_DATA_JSON={}
WECHAT_DEVICE_MESSAGE_MINIPROGRAM_STATE=trial
WECHAT_DEVICE_MESSAGE_TIMEOUT_MS=5000
# Official mini-program subscription messages. Each accepted template grants one send.
WECHAT_MINI_SUBSCRIPTION_START_TEMPLATE_ID=
WECHAT_MINI_SUBSCRIPTION_END_TEMPLATE_ID=
WECHAT_MINI_SUBSCRIPTION_START_DATA_JSON={}
WECHAT_MINI_SUBSCRIPTION_END_DATA_JSON={}
WECHAT_MINI_SUBSCRIPTION_PAGE=pages/today/index
WECHAT_MINI_SUBSCRIPTION_STATE=trial
WECHAT_MINI_SUBSCRIPTION_TIMEOUT_MS=5000
# Own verified service account. Keep all credentials only on the ECS server.
WECHAT_OFFICIAL_ACCOUNT_APP_ID=
WECHAT_OFFICIAL_ACCOUNT_APP_SECRET=
WECHAT_OFFICIAL_ACCOUNT_CALLBACK_TOKEN=
WECHAT_OFFICIAL_ACCOUNT_ENCODING_AES_KEY=
WECHAT_OFFICIAL_ACCOUNT_START_TEMPLATE_ID=
WECHAT_OFFICIAL_ACCOUNT_END_TEMPLATE_ID=
WECHAT_OFFICIAL_ACCOUNT_START_DATA_JSON={}
WECHAT_OFFICIAL_ACCOUNT_END_DATA_JSON={}
WECHAT_OFFICIAL_ACCOUNT_TIMEOUT_MS=5000
# WxPusher standard application. Keep AppToken and callback secret on the ECS server only.
WXPUSHER_APP_TOKEN=
WXPUSHER_APP_ID=
WXPUSHER_CALLBACK_SECRET=
WXPUSHER_ENDPOINT=https://wxpusher.zjiecode.com/api/send/message
WXPUSHER_QR_ENDPOINT=https://wxpusher.zjiecode.com/api/fun/create/qrcode
WXPUSHER_TIMEOUT_MS=5000
WXPUSHER_CHALLENGE_TTL_SECONDS=1800
WECHAT_LOGIN_TIMEOUT_MS=5000
# Experience-version sharing uses trial; switch to release after the mini program is published.
WECHAT_MINICODE_ENV_VERSION=trial
# Optional when api.weixin.qq.com must use a local HTTP proxy.
# HTTPS_PROXY=http://127.0.0.1:7897
# APP_DATA_STATE_FILE=./data/app-data.sqlite

# WeChat Cloud Hosting deployment.
# WECHAT_CLOUD_HOSTING=true
# PUBLIC_BASE_URL=https://YOUR_CLOUD_HOSTING_DOMAIN
# Required in Cloud Hosting. Generate a random value with at least 32 bytes.
# APP_SESSION_SECRET=
# APP_SESSION_TTL_MS=2592000000
# The existing camera is migrated to this WeChat OpenID. Never leave it empty in production.
# LEGACY_DEVICE_OWNER_OPENID=
# DEVICE_REGISTRY_BACKEND=cloudbase
# CLOUDBASE_ENV_ID=YOUR_CLOUDBASE_ENV_ID

# 直播参数
CHANNEL=0
STREAM=1
WEBRTC_FALLBACK_SECONDS=8

# Native replay relay / RTSP-to-HLS fallback.
# Use the camera LAN IP. The mini program can override this per replay session with device.ip.
JF_DEVICE_LAN_HOST=192.168.63.37
JF_DEVICE_LAN_HTTP_PORT=80
# JF_DEVICE_LAN_WS_PORT=
JF_DEVICE_LAN_SECURE=false
REPLAY_SESSION_TTL_MS=600000
# FFMPEG_PATH=

# Feed analysis
FEED_ANALYSIS_AUTOMATION_ENABLED=false
FEED_ANALYSIS_POLL_INTERVAL_MS=60000
FEED_ANALYSIS_GLOBAL_CONCURRENCY=2
FEED_ANALYSIS_PLAYBACK_SPEED=8
FEED_ANALYSIS_PLAYBACK_STREAM_TYPE=1
# Alarm bursts wake one short V3.2 confirmation task. The 30-minute statistics job remains unchanged.
FEEDING_START_CONFIRMATION_ENABLED=true
FEEDING_START_WINDOW_SECONDS=30
FEEDING_START_MAX_WINDOW_SECONDS=45
FEEDING_START_PRE_ROLL_SECONDS=15
FEEDING_START_MIN_WINDOW_SECONDS=20
FEEDING_START_CANDIDATE_TTL_SECONDS=120
FEEDING_START_REARM_QUIET_SECONDS=600
FEEDING_START_EXTENSION_SECONDS=10
FEEDING_START_MIN_EATING_SECONDS=6
FEEDING_START_MIN_SPAN_SECONDS=8
FEEDING_START_MIN_CONFIDENCE=0.6
FEEDING_START_MAX_EVIDENCE_AGE_SECONDS=5
FEED_ANALYSIS_RETRY_DELAY_MS=60000
FEED_ANALYSIS_MAX_RETRIES=3
# Analyzed recordings remain ready when CloudBase material synchronization fails.
# This caps independent material-sync retries after an application restart.
FEED_ANALYSIS_MATERIAL_SYNC_MAX_ATTEMPTS=10
FEED_ANALYSIS_ALARM_WINDOW_PADDING_SECONDS=300
FEED_ANALYSIS_ALARM_TIMEOUT_MS=3000
FEED_ANALYSIS_MIN_CONFIDENCE=0.35
# Use local to run server/src/feedAnalysis/vision_worker.py directly.
FEED_ANALYSIS_VISION_BASE_URL=local
FEED_ANALYSIS_TARGET=cat
FEED_ANALYSIS_DETECTOR_BACKEND=auto
# FEED_ANALYSIS_YOLO_MODEL=
FEED_ANALYSIS_VISION_TIMEOUT_MS=600000
# FEED_ANALYSIS_PYTHON=python
# FEED_ANALYSIS_STATE_FILE=./data/feed-analysis-state.sqlite
# FEED_ANALYSIS_WORKER_SCRIPT=./src/feedAnalysis/vision_worker.py
# Internal, temporary server-side activity test endpoint. Keep the token secret.
# FEED_ANALYSIS_TEST_TOKEN=
# FEED_ANALYSIS_TEST_INPUT_DIR=./data/feed-analysis-test-inputs
# FEED_ANALYSIS_TEST_TEMP_DIR=./data/feed-analysis-test-temp
# FEED_ANALYSIS_TEST_OUTPUT_DIR=./data/feed-analysis-test-results
FEED_ANALYSIS_TEST_MAX_FILE_MB=512
FEED_ANALYSIS_TEST_DEFAULT_DURATION_SEC=120
FEED_ANALYSIS_TEST_MAX_DURATION_SEC=1200

# Legacy PushPlus rollback configuration. It is no longer used by the main notification path.
# PUSHPLUS_TOKEN=
# Optional: this mini-program openid receives directly through PUSHPLUS_TOKEN without a friend binding.
# PUSHPLUS_OWNER_OPENID=
# PUSHPLUS_SECRET_KEY=
# PUSHPLUS_CALLBACK_SECRET=
# PUSHPLUS_ENDPOINT=https://www.pushplus.plus/send
# PUSHPLUS_OPEN_API_BASE_URL=https://www.pushplus.plus
# PUSHPLUS_CHANNEL=wechat
# PUSHPLUS_TIMEOUT_MS=5000

# Foodcast video generation. Put authorized audio files and library.json in FOODCAST_BGM_DIR.
# FOODCAST_BGM_DIR=./data/bgm
# FOODCAST_OUTPUT_DIR=./data/foodcasts
# FOODCAST_TEMP_DIR=./data/foodcast-temp
# FOODCAST_STATE_FILE=./data/foodcasts.sqlite
# FOODCAST_FFMPEG_PATH=
FOODCAST_CONCURRENCY=1
FOODCAST_MAX_RETRIES=2
FOODCAST_RETRY_DELAY_MS=5000
FOODCAST_RETENTION_DAYS=7
FOODCAST_MAX_STORAGE_GB=30
FOODCAST_CLEANUP_INTERVAL_MS=3600000
FOODCAST_MATERIAL_COLLECTION=foodcast_materials
# FOODCAST_MATERIAL_STATE_FILE=./data/foodcast-materials.sqlite
FOODCAST_MATERIAL_RETENTION_DAYS=7
FOODCAST_MEAL_GAP_MINUTES=10
FOODCAST_JOB_LEASE_SECONDS=300

# URL that local vision analysis can use to read backend HLS relay files.
# PUBLIC_BASE_URL=http://127.0.0.1:8000
# Persistent, credential-free JSONL diagnostics for device and cat account sync.
ACCOUNT_SYNC_AUDIT_FILE=./data/account-sync-audit.jsonl
# Optional temporary target for privacy-safe live playback diagnostics.
# LIVE_PLAYBACK_DIAGNOSTIC_SN=
